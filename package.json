{
  "private": true,
  "name": "secret-messages",
  "version": "1.0.0",
  "type": "module",
  "description": "Share confidential messages securely with anyone.",
  "homepage": "https://www.secretmessag.es/",
  "bugs": {
    "url": "https://github.com/nikolailehbrink/secret-messages/issues",
    "email": "mail@nikolailehbr.ink"
