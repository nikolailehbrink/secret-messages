# Local development uses a plain SQLite file – no auth token required.
TURSO_DATABASE_URL="file:./local.db"
# TURSO_AUTH_TOKEN=

# Production/Preview values come from the Turso integration on Vercel:
# TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token>"

# CRON_SECRET is deliberately missing here: Vercel cron jobs only run against
# production deployments, and the dev server skips the check entirely, so the
# variable is set in the production environment only.
